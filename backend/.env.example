# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_VERSION=v1

# Database Configuration
DB_TYPE=sqlite
DB_DATABASE=data/morning_board.db

# PostgreSQL Configuration (if using PostgreSQL instead of SQLite)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=morning_board
# DB_USER=your_user
# DB_PASSWORD=your_password

# JWT Configuration (uncomment when ready)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

# CORS Configuration
# CORS_ORIGIN=http://localhost:3000
