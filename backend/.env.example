# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_VERSION=v1

# Database Configuration
DB_TYPE=sqlite
DB_DATABASE=data/morning_board.db

# PostgreSQL Configuration (if using PostgreSQL instead of SQLite)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=morning_board
# DB_USER=your_user
# DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
# In development: If not set, all origins are allowed
# In production: Must be set to specific allowed origins (comma-separated)
# Examples:
#   CORS_ORIGIN=http://localhost:19006
#   CORS_ORIGIN=http://localhost:19006,http://localhost:19000
#   CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
# Mobile app development origins (automatically included in development):
#   - http://localhost:19006 (Expo default)
#   - http://localhost:19000,19001 (Expo alternatives)
#   - http://localhost:8081 (React Native Metro bundler)
# For physical devices, use your machine's IP address:
#   CORS_ORIGIN=http://192.168.1.100:19006,http://localhost:19006
